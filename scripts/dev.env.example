# Local overrides for scripts/dev.sh. Copy to scripts/dev.env (gitignored).
# Everything here is optional — the defaults work for a standard setup.

# --- Database (not managed by dev.sh; point it at yours) ---------------------
# CC_DEV_DB_HOST=127.0.0.1
# CC_DEV_DB_PORT=3306
# CC_DEV_DB_USER=root
# CC_DEV_DB_PASSWORD=root
# CC_DEV_DB_NAME=cityconnect
#
# Or supply the whole DSN and ignore the parts above:
# CC_DEV_DB_DSN='user:pass@tcp(127.0.0.1:3306)/cityconnect?charset=utf8mb4&parseTime=True&loc=Local'

# --- Ports -------------------------------------------------------------------
# CC_DEV_STUB_PORT=5273    # deliberately not 5173 — see the README
# CC_DEV_API_PORT=4021
# CC_DEV_WEB_PORT=5174

# --- Develop against a real C2 instead of the stub ---------------------------
# Setting this stops dev.sh starting the stub at all. The client must be
# registered in that C2 with redirect URI http://127.0.0.1:5174/api/auth/callback
# CC_DEV_C2_ORIGIN=http://localhost:5173
# CC_DEV_CLIENT_ID=<the registered client id>
# CC_DEV_CLIENT_SECRET=<its secret>

# --- Who gets the bootstrap admin grant --------------------------------------
# CC_DEV_ADMIN_SUB=jjamieson
