# CityConnect — muni-demo (QA). Rendered once by deploy/provision.sh.
#
# CONFIG IS SERVER STATE. A deploy ships code and never touches this file.
# To change something: edit it here and `systemctl restart cityconnect`.
#
# Mode 0600, owned by the service account. It holds the database password, the
# C2 client secret and the form-token signing key.
#
# Values that can contain a space or a shell metacharacter are QUOTED. systemd
# strips the outer quotes, so the service reads them unchanged — but the file
# is also meant to be `source`-able, because that is how ccadm is run and how
# an operator inspects it on the server. Unquoted, `CC_DB_DSN=…@tcp(127.0.0.1…`
# is a bash syntax error and `CC_SMTP_FROM_NAME=City of Dev-Pro` tries to run a
# command called `of`.

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
CC_ENV=prod
CC_LOG_LEVEL=info

# Loopback only. Apache terminates TLS on both hostnames and proxies here.
# THIS BINDING IS THE SECURITY MODEL: the portal vhost default-denies most of
# /api, and an API reachable on a public interface makes every one of those
# rules decoration. Do not widen it.
CC_ADDR=127.0.0.1:@@PORT@@

# Both SPAs are served at the root of their own hostname, so there is no path
# prefix for Apache to strip and this stays empty.
CC_BASE_PATH=

# The staff console's origin, and the citizen portal's. Two names, two cookie
# jars: script on the public site has no ambient authority over a staff
# session in the same browser.
CC_PUBLIC_URL=https://@@ADMIN_DOMAIN@@
CC_PORTAL_PUBLIC_URL=https://@@PORTAL_DOMAIN@@

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MySQL 8 shared with C2, parking and facility-booking. This user has rights on
# its own schema and nothing else.
CC_DB_DSN="@@DB_USER@@:@@DB_PASSWORD@@@tcp(127.0.0.1:3306)/@@DB_NAME@@?charset=utf8mb4&parseTime=True&loc=Local"
# Sized for a 2GB demo box that is already running C2, MySQL, clamd, parking
# and facility-booking — not for a municipality. Raise it on real hardware.
CC_DB_MAX_OPEN=5
CC_DB_MAX_IDLE=2

# Off, and it has to be: config validation refuses AutoMigrate on any
# deployment that is not CC_ENV=dev or test, and CC_ENV=prod is what turns on
# the C2 credential checks and the guard against binding the API publicly.
# Dodging that by calling an internet-facing box "dev" would trade a real
# safety net for a convenience.
#
# deploy/deploy.sh runs `ccadm migrate` instead, before restarting the service.
# An explicit step in the deploy beats the service mutating its own schema at
# boot anyway: it fails where somebody is watching.
CC_DB_AUTOMIGRATE=false

# ---------------------------------------------------------------------------
# C2 — identity, messaging and the service card
# ---------------------------------------------------------------------------
CC_C2_PORTAL_ORIGIN=@@C2_ORIGIN@@
CC_C2_ISSUER=@@C2_ORIGIN@@/oidc
CC_C2_CLIENT_ID=@@C2_CLIENT_ID@@
CC_C2_CLIENT_SECRET="@@C2_CLIENT_SECRET@@"
CC_C2_SCOPES=openid,profile,email

# One OIDC client, two callbacks — one per origin. Both are registered on the
# client in C2; an unregistered one is refused with an opaque error.
CC_C2_REDIRECT_URL=https://@@ADMIN_DOMAIN@@/api/auth/callback
CC_C2_PORTAL_REDIRECT_URL=https://@@PORTAL_DOMAIN@@/api/auth/callback
CC_C2_POST_LOGOUT_REDIRECT_URL=https://@@ADMIN_DOMAIN@@/
CC_C2_PORTAL_POST_LOGOUT_REDIRECT_URL=https://@@PORTAL_DOMAIN@@/

# Partner notifications — the "messaging" integration. The partner API is a
# SIBLING of /api, not under it.
CC_C2_PARTNER_BASE_URL=@@C2_ORIGIN@@
CC_C2_NOTIFY_AUDIENCE=@@C2_ORIGIN@@

# Messaging authenticates with HTTP Basic (the client id and secret above)
# because the two settings below are unset.
#
# Setting them switches internal/c2/notify to signed private_key_jwt
# assertions, which is better — no shared secret on the wire. But it is a
# TWO-PART change and doing half of it breaks messaging:
#
#   1. Uncomment these two and restart. /api/c2/jwks then publishes the public
#      key; until now it has served an empty key set, which is why C2 cannot
#      be pointed at it yet.
#   2. Have the C2 administrator register the JWKS URI
#      https://@@PORTAL_DOMAIN@@/api/c2/jwks on client @@C2_CLIENT_ID@@.
#
# Between those two steps every notification is rejected. Do them together.
# The key itself is already generated and waiting at the path below.
# CC_C2_CLIENT_PRIVATE_KEY_FILE=@@APP_DIR@@/keys/client-signing.pem
# CC_C2_CLIENT_KID=@@CLIENT_KID@@

# The service card callout. signed_jwt is what the application is registered
# with in C2, and the static app-key fallback stays off — it is a shared secret
# in a header and exists only for a C2 that cannot sign.
CC_C2_CALLOUT_ALLOW_APP_KEY=false
CC_C2_CALLOUT_CACHE_TTL=20s
CC_C2_CALLOUT_MAX_TASKS=10
# Quick links on the card. Every code must exist in the catalogue AND be
# published and publicly visible, or it is dropped with a warning in the log.
CC_C2_CALLOUT_QUICK_LINKS=GENERAL,MISSED-COLLECTION

# ---------------------------------------------------------------------------
# Sessions and proxy
# ---------------------------------------------------------------------------
CC_SESSION_TTL=8h
CC_SESSION_IDLE_TTL=2h
CC_COOKIE_SECURE=true
# Apache sets X-Forwarded-Proto and X-Forwarded-For. Without this every request
# appears to come from the proxy, and the rate limiters below would throttle
# the whole internet as one caller.
CC_TRUST_PROXY_HEADERS=true
CC_RATE_LIMIT_PER_MIN=600

# ---------------------------------------------------------------------------
# The first administrator
# ---------------------------------------------------------------------------
# C2 SSO is the only staff login, so nobody can grant the first role through
# the console — a fresh deployment is locked out until a subject is named here
# or `ccadm grant-role` is run. Applied on every boot, idempotent.
#
# This is the C2 SUBJECT IDENTIFIER, not an email address. Read it from `sub`
# in your own id_token, or ask the C2 administrator.
CC_BOOTSTRAP_ADMIN_SUBS=@@BOOTSTRAP_ADMIN_SUBS@@

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Exactly one instance may run these. Two schedulers against one database
# double-send every citizen notification.
CC_JOBS_ENABLED=true
CC_JOB_AUTOCLOSE_AFTER=336h
CC_JOB_OUTBOX_MAX_ATTEMPTS=8

# ---------------------------------------------------------------------------
# Email — the guest notification channel
# ---------------------------------------------------------------------------
# This is NOT the main notification path. A citizen with a C2 account and
# active consent is reached through C2's partner API (the settings above),
# which delivers over their own chosen channels — C2 sends that mail with
# Resend itself.
#
# This path exists for the people C2 cannot reach at all: guests and anonymous
# reporters who left an address but have no C2 account. C2's API is addressed
# by subject id and refuses an unknown one with 404 — you never hand it an
# email address — so there is no way to route these through it. Since Sprint 1
# is built around exactly those residents, this is most of the demo's mail.
#
# Pointed at Resend's own SMTP interface, so both paths leave from the same
# provider and the same verified domain.
#
# The username is the literal string "resend"; the password is an API key.
# Port 465 with CC_SMTP_STARTTLS=false works too, for implicit TLS.
CC_SMTP_HOST=@@SMTP_HOST@@
CC_SMTP_PORT=587
CC_SMTP_STARTTLS=true
CC_SMTP_USERNAME=resend
CC_SMTP_PASSWORD="@@SMTP_PASSWORD@@"

# THE SENDING DOMAIN MUST BE VERIFIED IN RESEND, AND VERIFICATION IS EXACT.
# A domain being verified does not verify its subdomains — dev-pro.app is
# verified, so cityconnect.dev-pro.app is NOT, and deriving this address from
# the portal hostname would be wrong.
#
# Getting it wrong does not fail loudly. Resend refuses an unverified sender
# with a 5xx, internal/mailer classifies that as permanent, and the recipient
# is suppressed as `bounced` and never retried — so one bad value quietly
# poisons every guest address it touches rather than erroring once.
#
# After the first guest submission, confirm nothing was suppressed:
#   journalctl -u cityconnect | grep -i "bounce\|suppress"
CC_SMTP_FROM=@@MAIL_FROM@@
CC_SMTP_FROM_NAME="City of Dev-Pro"
CC_SMTP_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Attachments and the malware scanner
# ---------------------------------------------------------------------------
# clamd's unix socket, not a TCP port: nothing crosses the network, and the
# socket is mode 0666 so the service account needs no group membership.
#
# Unset, this fails quietly — every upload stays in quarantine and is never
# served, while the resident is told the photo arrived. Nothing errors at boot.
#
# clamd on this box holds its whole signature database resident (~960MB on a
# 2GB server). Check `ConcurrentDatabaseReload no` is set in /etc/clamav/
# clamd.conf: the default loads a SECOND copy on every hourly signature update,
# which on a box this size invites the OOM killer — and its biggest targets
# after clamd are MySQL and C2, not us.
CC_SCANNER_ADDRESS=/var/run/clamav/clamd.ctl
CC_SCANNER_TIMEOUT=30s

# Whether a missing scanner is a fault or a choice. It does not change what
# happens to an upload — with no scanner, attachments are refused either way,
# because accepting one that can never be scanned means quarantining it for
# ever. It changes how loudly that is reported at boot.
#
# Leave it true here. On a box too small for clamd's full signature database,
# the better answer than switching the scanner off is a minimal database: a
# one-signature set still catches EICAR and proves the whole quarantine →
# scan → promote path, at about 22MB resident instead of 960MB.
CC_SCANNER_REQUIRED=true
CC_ATTACHMENT_DIR=@@APP_DIR@@/data/attachments
CC_ATTACHMENT_MAX_MB=25

# ---------------------------------------------------------------------------
# Public endpoint hardening
# ---------------------------------------------------------------------------
CC_TRACK_RATE_LIMIT_PER_MIN=10
CC_PUBLIC_FORM_RATE_PER_MIN=10
CC_FORM_TOKEN_MIN_AGE=2s

# Signs the single-use tokens on anonymous and guest submissions. Generated
# here rather than left to the per-instance default, because that default is
# per-BOOT: behind more than one instance a report is refused at random, which
# looks exactly like a flaky form and gets blamed on the network for a
# fortnight. One instance today; set it anyway so that stays true.
CC_FORM_TOKEN_SECRET="@@FORM_TOKEN_SECRET@@"

# References read BBY-… rather than SR-…, because a Burnaby demo quoting
# somebody else's prefix looks like somebody else's software.
CC_REFERENCE_PREFIX=BBY
