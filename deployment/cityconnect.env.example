# CityConnect configuration.
#
# Copy to /opt/cityconnect/cityconnect.env, fill in the real values, and
# restrict it: `chown root:cityconnect` and `chmod 0640`. It holds credentials.

# --- Application -------------------------------------------------------------
CC_ENV=prod
# Loopback. Apache is the only thing that connects to this port, from the same
# host. The separation between the staff console and the citizen portal is
# enforced by what each vhost is allowed to proxy, so an API reachable from
# anywhere else routes straight around it. This is also the default in prod —
# set it only to override, e.g. `0.0.0.0:4021` in a container or behind an
# external load balancer, where loopback would make the service unreachable.
CC_ADDR=127.0.0.1:4021
CC_BASE_PATH=/cityconnect
CC_PUBLIC_URL=https://city.example.gov
# The citizen portal's own origin. A separate host, not a path: it gives the
# public app its own cookie jar, so script there has no ambient authority over
# a staff session in the same browser. Apache serves /api on both origins,
# which keeps each app's calls same-origin.
CC_PORTAL_PUBLIC_URL=https://services.example.gov
CC_LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
CC_DB_DSN=cityconnect:<REPLACE_ME>@tcp(127.0.0.1:3306)/cityconnect?charset=utf8mb4&parseTime=True&loc=Local
CC_DB_MAX_OPEN=25
CC_DB_MAX_IDLE=5
# AutoMigrate is a development convenience. Production uses versioned
# migrations, applied deliberately — schema changes must not ride along with a
# binary deploy.
CC_DB_AUTOMIGRATE=false

# --- C2 (TrustIdentity) ------------------------------------------------------
# The portal origin is the single public host that serves the citizen portal
# and fronts C2's API. Never point at C2's internal API host or port: the
# issuer is the portal origin, and every token carries it as `iss`.
CC_C2_PORTAL_ORIGIN=https://portal.example.gov/c2
CC_C2_ISSUER=https://portal.example.gov/c2/oidc

CC_C2_CLIENT_ID=<REPLACE_ME>
CC_C2_CLIENT_SECRET=<REPLACE_ME>

# Redirect URIs are exact-match. Register every variant actually used —
# a trailing slash or an http/https difference is a different URI to C2.
CC_C2_REDIRECT_URL=https://city.example.gov/cityconnect/api/auth/callback
# One redirect URI per origin — C2 matches them exactly, so the portal needs
# its own registration.
CC_C2_PORTAL_REDIRECT_URL=https://services.example.gov/api/auth/callback
# Where the browser lands after signing out. OPTIONAL, and unset by default —
# set each only once the C2 administrator has registered that exact string.
# C2 exact-matches these, so an unregistered value fails the sign-out with
# `post_logout_redirect_uri invalid` rather than degrading. Left unset, C2 ends
# the session and shows its own signed-out page, which always works.
#
# One per origin, like the redirect URIs: a citizen returned to the staff
# console would get a sign-in page that refuses them.
# CC_C2_POST_LOGOUT_REDIRECT_URL=https://city.example.gov/cityconnect/
# CC_C2_PORTAL_POST_LOGOUT_REDIRECT_URL=https://services.example.gov/

CC_C2_SCOPES=openid,profile,email

# --- Partner notifications ---------------------------------------------------
# Mounted at <base>/partner, a sibling of the OIDC endpoints — not under /api.
CC_C2_PARTNER_BASE_URL=https://portal.example.gov/c2
# The audience for our client assertions: this deployment's issuer as the C2
# administrator states it, which is not necessarily the OIDC issuer above.
CC_C2_NOTIFY_AUDIENCE=https://portal.example.gov/c2

# Private-key JWT is preferred: no shared secret crosses the wire. Publish the
# matching public key at <public url>/cityconnect/api/c2/jwks and register that
# URL with the C2 administrator. Falls back to HTTP Basic when unset.
CC_C2_CLIENT_PRIVATE_KEY_FILE=/opt/cityconnect/keys/client-signing.pem
CC_C2_CLIENT_KID=cityconnect-2026-01

# --- Service Card callout ----------------------------------------------------
# Give the C2 administrator these, all on the citizen origin. C2 is external
# and cannot reach the API's port; Apache proxies from the public host to
# 127.0.0.1:4021.
#
#   callout               https://services.example.gov/api/citizens/{sub}/status
#   backchannel logout    https://services.example.gov/api/c2/backchannel-logout
#   our JWKS              https://services.example.gov/api/c2/jwks
#
# Signed JWT is the default and needs no configuration — the assertion is
# verified against the same JWKS as id_tokens. Enable app_key only if the C2
# administrator configured that legacy mode for this application.
CC_C2_CALLOUT_ALLOW_APP_KEY=false
# CC_C2_CALLOUT_APP_KEY=<REPLACE_ME>
# CC_C2_CALLOUT_APP_SECRET=<REPLACE_ME>

# C2 does not cache callout responses and calls on every render plus a timer,
# so a short cache here is what keeps the endpoint inside its ~5s budget.
CC_C2_CALLOUT_CACHE_TTL=20s
CC_C2_CALLOUT_MAX_TASKS=10
# Service types offered on the card as "report something new" shortcuts,
# alongside whatever the citizen already has open. Catalogue codes, not labels:
# the wording comes from the catalogue, so renaming a service in the console
# follows through. A code that is unknown, retired, or hidden from the public
# is skipped rather than advertised — a card must not link somewhere the portal
# would refuse. A link to the full catalogue is always appended.
#
# Open requests keep at least half the card, so these never crowd out the
# citizen's own business.
CC_C2_CALLOUT_QUICK_LINKS=GENERAL,MISSED-COLLECTION

# --- Sessions and security ---------------------------------------------------
CC_SESSION_TTL=8h
CC_SESSION_IDLE_TTL=2h
CC_COOKIE_SECURE=true
CC_TRUST_PROXY_HEADERS=true
CC_RATE_LIMIT_PER_MIN=600

# --- Bootstrap ---------------------------------------------------------------
# The only route to a first administrator. With C2 SSO as the sole staff login
# there is nobody who can grant the first role, so a fresh deployment is locked
# out without this. Comma-separated C2 subject identifiers; safe to leave set.
CC_BOOTSTRAP_ADMIN_SUBS=<REPLACE_ME>

# --- Background jobs ---------------------------------------------------------
# Run exactly one instance with jobs enabled. Two schedulers against one
# database will double-send notifications.
CC_JOBS_ENABLED=true
CC_JOB_AUTOCLOSE_AFTER=336h
CC_JOB_OUTBOX_MAX_ATTEMPTS=8

# --- Attachments -------------------------------------------------------------
CC_ATTACHMENT_DIR=/opt/cityconnect/data/attachments
CC_ATTACHMENT_MAX_MB=25

# Public request tracking (POST /api/portal/requests/track) is unauthenticated,
# and the contact detail quoted with the reference is the only thing standing
# between a caller and somebody else's report. This limit is therefore a
# security control, not capacity management: the reference format's entropy is
# sized on the assumption that guessing is throttled, so raising this weakens
# the reference as well. Counted per source address and per reference.
CC_TRACK_RATE_LIMIT_PER_MIN=10

# Anonymous reporting is an unauthenticated write endpoint, so it is gated by a
# single-use, signed, time-bound token fetched when the form opens. This bounds
# both handing tokens out and spending them; because every anonymous report
# needs a fresh token, issuance is the real sustained ceiling. Set generously —
# an office, a library and a block of flats all share one address, and locking
# out a whole building to stop one script is the worse failure.
CC_PUBLIC_FORM_RATE_PER_MIN=10

# Shortest gap between a form being opened and submitted that we believe came
# from a person. It penalises being fast, never slow, so it cannot catch someone
# using a screen reader. Set to 0 only in a test.
CC_FORM_TOKEN_MIN_AGE=2s

# Signs those tokens. Leave empty on a single instance and one is generated at
# boot. **Set it when running more than one instance**, or a token issued by one
# will not verify at another and residents will see submissions refused at
# random. Any long random string.
# CC_FORM_TOKEN_SECRET=<REPLACE_ME>

# --- Request references -------------------------------------------------------
# Leads every new reference, e.g. BBY-7K4M-2QX9. Letters and digits only, up to
# eight characters; anything else is stripped and an empty value falls back to
# SR. The rest of the reference is drawn at random rather than counted up, so
# one reference reveals nothing about any other or about the city's volumes.
# Changing this does not touch references already issued.
CC_REFERENCE_PREFIX=SR
